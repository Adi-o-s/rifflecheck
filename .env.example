# Optional. Without a key the app runs in demo mode: rule checks work in full,
# and AI review returns prepared responses for the three built-in samples.
# Free key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model with structured (JSON schema) output.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Tried when the main model is rate limited (each model has its own free quota).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
